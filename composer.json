{
  "name": "me/notes-app-magical",
  "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.0",
        "yiisoft/yii2": "^2.0.49",
        "yiisoft/yii2-bootstrap5": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "frontend\\": "frontend/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}